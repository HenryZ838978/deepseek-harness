# ============ Required ============
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============ Optional: endpoint ============
# Official:    https://api.deepseek.com           (OpenAI-compat chat completions)
# Official β:  https://api.deepseek.com/beta      (strict mode; remaps v4-pro -> reasoner)
# Anthropic:   https://api.deepseek.com/anthropic (Anthropic-format wire protocol)
# vLLM:        http://your-vllm:8000/v1
# SGLang:      http://your-sglang:30000/v1
# OpenRouter:  https://openrouter.ai/api/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ============ Optional: model ============
# Modern (V4): deepseek-v4-pro  ·  deepseek-v4-flash
# Legacy alias: deepseek-chat (= v4-flash thinking-off)  ·  deepseek-reasoner (= v4-flash thinking-on)
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_REASONER_MODEL=deepseek-v4-pro

# ============ Optional: probe behaviour ============
PROBE_DEFAULT_N=10
PROBE_DUMP_RAW=1
PROBE_FINDINGS_DIR=reports/raw
