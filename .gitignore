.venv/
__pycache__/
*.pyc
*.egg-info/
build/
# Python `dist/` lives at repo root only — keep this rule anchored so it
# does NOT also swallow packages/desktop/dist/ (which carves out README.md).
/dist/
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
packages/mcp/dist/

# Raw probe outputs are large and may contain API echoes — only summaries
# (per-probe markdown) and the human-readable REPORT are committed.
reports/raw/**/*.jsonl
reports/raw/**/*.json
!reports/raw/.gitkeep
!reports/raw/README.md

# Editor
.idea/
.vscode/

# Swift / SwiftPM build artifacts (packages/desktop)
.build/
.swiftpm/
*.xcodeproj/xcuserdata/
DerivedData/

# macOS
.DS_Store

# Runtime data (server local dev)
packages/server/data/
/data/

# Local secrets — never commit
**/secrets.env
**/.env.local
*.pem
*.key

# packages/desktop build artifacts
# - Resources/runtime/ is regenerated by Scripts/bundle-node.sh (≈ 497 MB,
#   portable Node + bundled dsh-server + claude-code single-binary).
# - dist/*.dmg are reproducible build outputs (`hdiutil create …`).
# - dist/README.md is checked in (carve-out below).
packages/desktop/Resources/runtime/
packages/desktop/dist/*
!packages/desktop/dist/README.md

# deploy/mdou — never commit live deployment records (URLs, bearers, IDs)
deploy/mdou/DEPLOYED.md


# Root-level Dockerfile / .dockerignore symlinks added at deploy time so
# mdou's build context autodetection finds them. The real files live at
# deploy/mdou/. Do not commit these symlinks.
/Dockerfile
/.dockerignore
